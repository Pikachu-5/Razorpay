# ---- App ----
APP_ENV=dev
LOG_LEVEL=INFO

# ---- Database (matches docker-compose.yml) ----
DATABASE_URL=postgresql+asyncpg://recovery:recovery@localhost:55432/recovery

# ---- Razorpay Test Mode ----
# Dashboard -> Settings -> API Keys -> Generate Test Mode keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook secret set when registering the webhook URL in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=

# Razorpay API base (override only for tests/mocks)
RAZORPAY_BASE_URL=https://api.razorpay.com
# Explicit safety boundary. Keep `test` until a separately reviewed live rollout.
RAZORPAY_MODE=test
# Records recommendations and audits but blocks customer-facing side effects.
SHADOW_MODE=true

# Closes the demo loop locally: simulated (synthetic) opportunities get an
# attributable *simulated* payment link instead of being dropped as shadowed,
# so recovery, verification and the experiment have something to measure.
# Never makes a Razorpay call and never applies to real traffic.
SIMULATE_INTERVENTIONS=false

# ---- Control-plane authentication ----
# Required when APP_ENV is anything other than dev/test/local. Clients send it
# on every state-changing operator request as X-Control-Plane-Key.
CONTROL_PLANE_API_KEY=
# Optional distinct key for force model promotions. In dev/test/local an empty
# key intentionally enables the local-demo operator without a header.
CONTROL_PLANE_ADMIN_API_KEY=
# The dashboard sends this build-time value as X-Control-Plane-Key when set.
VITE_CONTROL_PLANE_KEY=

# ---- Policy engine (deterministic guardrails) ----
POLICY_KILL_SWITCH=false
POLICY_MAX_AMOUNT_MINOR=2500000
POLICY_MAX_CONTACT_ATTEMPTS=3
POLICY_COOLDOWN_MINUTES=60
POLICY_CONFIDENCE_FLOOR=0.35
POLICY_MIN_EV_MARGIN_MINOR=500

# ---- Tunnel (ngrok) ----
# Public https URL forwarding to the backend, e.g. https://abc123.ngrok-free.app
# Used for: webhook registration helper + payment link redirect checks
PUBLIC_BASE_URL=
NGROK_AUTHTOKEN=
