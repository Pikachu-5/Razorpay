# ---- App ----
# dev/test/local skip control-plane authentication entirely. The code defaults
# to `production` precisely so a deployment that forgets this line fails closed
# rather than inheriting the convenient value.
APP_ENV=dev
LOG_LEVEL=INFO

# ---- Database (matches docker-compose.yml) ----
DATABASE_URL=postgresql+asyncpg://recovery:recovery@localhost:55432/recovery

# ---- Razorpay Test Mode ----
# Dashboard -> Settings -> API Keys -> Generate Test Mode keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook secret set when registering the webhook URL in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=

# Razorpay API base (override only for tests/mocks)
RAZORPAY_BASE_URL=https://api.razorpay.com
# Explicit safety boundary. Keep `test` until a separately reviewed live rollout.
RAZORPAY_MODE=test
# Records recommendations and audits but blocks customer-facing side effects.
SHADOW_MODE=true

# Closes the demo loop locally: simulated (synthetic) opportunities get an
# attributable *simulated* payment link instead of being dropped as shadowed,
# so recovery, verification and the experiment have something to measure.
# Never makes a Razorpay call and never applies to real traffic.
SIMULATE_INTERVENTIONS=false

# ---- Control-plane authentication ----
# Required when APP_ENV is anything other than dev/test/local. Clients send it
# on every state-changing operator request as X-Control-Plane-Key.
CONTROL_PLANE_API_KEY=
# Optional distinct key for force model promotions. In dev/test/local an empty
# key intentionally enables the local-demo operator without a header.
CONTROL_PLANE_ADMIN_API_KEY=

# A public demonstration install that deliberately leaves operator actions
# unauthenticated so a reviewer can drive the console without credentials.
# It is refused unless RAZORPAY_MODE=test, it never grants admin (forced model
# promotion still needs CONTROL_PLANE_ADMIN_API_KEY), the startup log warns
# about it, and the console shows an "Open demo - no key" badge. Leave false
# for anything that is not a throwaway demo.
CONTROL_PLANE_OPEN_DEMO=false

# Bounds that apply ONLY while CONTROL_PLANE_OPEN_DEMO is active, so a public
# visitor cannot exhaust a shared install. They sit above what the console's own
# presets ask for (the largest is 90 payments over 60s), so ordinary use never
# reaches them. A local install is not rationed by any of these.
DEMO_MAX_PAYMENTS_PER_MINUTE=150
DEMO_MAX_DURATION_SECONDS=120
# Refuses new runs once this many synthetic payments exist. Per-run limits cap
# each run; only this caps the total across an unattended weekend.
DEMO_MAX_SYNTHETIC_PAYMENTS=50000
# Paces runs globally rather than per IP. Only one simulation runs at a time, so
# the contended resource is global -- and a global limit cannot be evaded by
# arriving from a different address or spoofing a forwarded-for header.
DEMO_SIMULATION_COOLDOWN_SECONDS=30

# NOTE: there is deliberately no VITE_CONTROL_PLANE_KEY. Vite inlines build-time
# values into the public JavaScript bundle, so setting the operator key there
# published it to every visitor. The console reads the key at runtime from
# sessionStorage instead:
#   sessionStorage.setItem('recover_control_plane_key', '<key>')

# ---- Policy engine (deterministic guardrails) ----
POLICY_KILL_SWITCH=false
POLICY_MAX_AMOUNT_MINOR=2500000
POLICY_MAX_CONTACT_ATTEMPTS=3
POLICY_COOLDOWN_MINUTES=60
POLICY_CONFIDENCE_FLOOR=0.35
POLICY_MIN_EV_MARGIN_MINOR=500

# ---- Tunnel (ngrok) ----
# Public https URL forwarding to the backend, e.g. https://abc123.ngrok-free.app
# Used for: webhook registration helper + payment link redirect checks
PUBLIC_BASE_URL=
NGROK_AUTHTOKEN=
